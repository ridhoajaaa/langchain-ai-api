# ============================================
# LangChain - Environment Variables
# ============================================
# Copy this file to .env and fill in your keys.
#   cp .env.example .env

# --- Ollama Cloud (FREE) ---
# No API key needed, no download needed.
# Free cloud models:  qwen3-coder-next:cloud  (default), nemotron-3-super:cloud, minimax-m2.5:cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder-next:cloud

# --- OpenAI ---
# Sign up: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Anthropic Claude ---
# Sign up: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# --- Google Gemini ---
# Sign up: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# --- LangSmith (Optional: Tracing & Debugging) ---
# Sign up: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=ls-your-langsmith-api-key
